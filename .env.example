HOST=127.0.0.1
PORT=28783

# The local node port defaults to the selected network.
# TENRAI_URL=http://127.0.0.1:28701
TENRAI_TARGET=node
# TENRAI_NETWORK=development

# Public Tenrai API.
# TENRAI_URL=https://api.tenrai-technologies.org
# TENRAI_TARGET=api

# Requests per minute per client. Zero disables the rate limit.
# TENRAI_RATE_LIMIT=1200
